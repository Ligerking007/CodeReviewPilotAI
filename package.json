{
  "name": "codereviewpilot-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/mobile"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api",
    "dev:mobile": "npm run start -w apps/mobile",
    "test": "npm run test -w apps/api && npm run test -w apps/mobile",
    "lint": "npm run lint -w apps/api && npm run lint -w apps/mobile",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
