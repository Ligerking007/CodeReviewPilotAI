# Docker Compose runtime configuration.
# Copy this file to .env for local runs, or provide these values from your hosting platform/GitHub Secrets during deployment.

POSTGRES_USER=codereviewpilot
POSTGRES_PASSWORD=codereviewpilot
POSTGRES_DB=codereviewpilot
DATABASE_URL=postgresql://codereviewpilot:codereviewpilot@postgres:5432/codereviewpilot?schema=public

JWT_SECRET=replace-with-a-long-random-secret
APP_WEB_REDIRECT_URL=http://localhost:8081/auth/callback
APP_PUBLIC_URL=https://ligerking007.github.io/CodeReviewPilotAI
GITHUB_ALLOWED_USERNAMES=Ligerking007,JakapanK

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
AI_REVIEW_RATE_LIMIT_TTL_MS=3600000
AI_REVIEW_RATE_LIMIT_MAX=5

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_APP_BASE_URL=http://localhost:8081
